# App URL (used for generating Comrade/Witness magic links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Auth, Postgres DB, Private Evidence Storage)
# Publishable keys are preferred for new Supabase projects. The anon key is still accepted.
# Copy these into .env.local. Placeholder values keep the app in local preview mode.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Open-Source AI Stack (Works with Ollama locally, or Groq / vLLM / OpenRouter in production)
# Leave the key unset to use the on-device journal fallback (no invented symptoms).
OPEN_LLM_BASE_URL="https://api.groq.com/openai/v1"
# Or http://localhost:11434/v1 for local Ollama
OPEN_LLM_API_KEY="your-open-weights-api-key"
OPEN_LLM_MODEL="llama-3.3-70b-versatile"
OPEN_STT_MODEL="whisper-large-v3-turbo"

# VA Lighthouse Developer Sandbox API (https://developer.va.gov)
# Leave the key unset to use the built-in sandbox simulation (nothing is sent to VA).
VA_LIGHTHOUSE_BASE_URL="https://sandbox-api.va.gov"
VA_LIGHTHOUSE_API_KEY="your-va-lighthouse-sandbox-key"
# Required only if VA_LIGHTHOUSE_BASE_URL points at production api.va.gov.
# Sandbox submissions stay off unless you set a real sandbox key.
VA_LIGHTHOUSE_ALLOW_PRODUCTION="false"
